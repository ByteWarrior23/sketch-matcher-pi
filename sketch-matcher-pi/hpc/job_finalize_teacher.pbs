#!/bin/bash
#PBS -N sketch_finalize_teacher
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /Data4/ee_24126016/sketch_matcher/finalize_teacher.log

# GPU job: recover teacher artifacts from the stage-3 checkpoint if the main
# 48h job was walltime-killed mid-stage-3 (train.py's end-of-teacher save
# never runs). Produces teacher_model.keras + teacher embedding cache, then
# runs the GO/NO-GO gate (hpc/verify_teacher.py).
#
# Usage: qsub hpc/job_finalize_teacher.pbs
#        (set H100_WAIT_MIN=0 to grab any free GPU immediately)

cd /Data4/ee_24126016/sketch_matcher

export TF_PYTHON=/Data4/ee_24126016/.conda/envs/sketch_matcher/bin/python
if [ ! -x "$TF_PYTHON" ]; then
  source /apps/compilers/anaconda3/etc/profile.d/conda.sh
  conda activate sketch_matcher
  export TF_PYTHON="$CONDA_PREFIX/bin/python"
fi
if [ ! -x "$TF_PYTHON" ]; then
  echo "FATAL: no working env python ($TF_PYTHON)"
  exit 2
fi
export PYTHONNOUSERSITE=1
export OMP_NUM_THREADS=4
export TF_NUM_INTRAOP_THREADS=4
export TF_NUM_INTEROP_THREADS=1
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4
export PATH="/usr/local/cuda-13.0/bin:$PATH"
export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false --xla_gpu_autotune_level=0"
echo "Using python: $TF_PYTHON"

# --- GPU: prefer full H100 briefly, else MIG slice (inference is light) ---
pick_full() {
  while IFS= read -r line; do
    local IDX UUID USED_MEM
    IDX=$(printf '%s\n' "$line" | cut -d',' -f1 | tr -d ' ')
    UUID=$(nvidia-smi --query-gpu=uuid --format=csv,noheader -i "$IDX" 2>/dev/null | tr -d '\r' | head -1)
    USED_MEM=$(nvidia-smi --query-compute-apps=gpu_index,used_gpu_memory --format=csv,noheader 2>/dev/null \
      | awk -v i="$IDX" -F', ' '$1==i {gsub(/MiB/,"",$2); s+=$2} END {print s+0}')
    if [ -z "$USED_MEM" ] || [ "$USED_MEM" -lt 4096 ]; then echo "$UUID"; return; fi
  done < <(nvidia-smi --query-gpu=index,mig.mode.current --format=csv,noheader 2>/dev/null | grep -i disabled)
}
pick_mig() {
  local USED=$(nvidia-smi --query-compute-apps=gpu_uuid --format=csv,noheader 2>/dev/null | sort -u)
  for u in $(nvidia-smi -L 2>/dev/null | grep "MIG" | sed 's/.*(UUID: //; s/)//'); do
    if ! printf '%s\n' "$USED" | grep -q "$u"; then echo "$u"; return; fi
  done
}
if [ -z "$CUDA_VISIBLE_DEVICES" ]; then
  export H100_WAIT_MIN="${H100_WAIT_MIN:-45}"
  echo "$(date) Waiting up to ${H100_WAIT_MIN} min for a FREE FULL H100..."
  WAITED=0
  while [ $WAITED -lt $H100_WAIT_MIN ]; do
    U=$(pick_full)
    if [ -n "$U" ]; then break; fi
    sleep 600
    WAITED=$((WAITED + 10))
  done
  if [ -z "$U" ]; then
    U=$(pick_mig)
    if [ -z "$U" ]; then
      echo "$(date) ERROR: no GPU free. Requeue manually."
      exit 1
    fi
    echo "$(date) WARNING: full H100 busy; falling back to MIG slice $U"
  else
    echo "$(date) Got FULL H100: $U"
  fi
  export CUDA_VISIBLE_DEVICES="$U"
fi
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
nvidia-smi -L

$TF_PYTHON hpc/finalize_teacher.py
echo "---- teacher gate ----"
$TF_PYTHON hpc/verify_teacher.py
