#!/bin/bash
#PBS -N sketch_preprocess
#PBS -q cpuq
#PBS -l select=1:ncpus=1
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o preprocess.log

# CPU-ONLY queue job: preprocess datasets into data/processed/*.npy.
# Raw datasets are staged ahead of time under data/raw/ (sketchy, quickdraw,
# tuberlin, imagenet-sketch). This job only downloads if staging is missing.
# Single-threaded script -> ncpus=1.
# Submit from the project dir:
#   cd /Data4/ee_24126016/sketch_matcher && /opt/pbs/bin/qsub hpc/job_preprocess.pbs

cd "$PBS_O_WORKDIR"

source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate sketch_matcher
export PYTHONNOUSERSITE=1
TF_PYTHON="$CONDA_PREFIX/bin/python"
echo "Using python: $TF_PYTHON"

if [ ! -d "$PBS_O_WORKDIR/data/raw/sketchy/sketch" ]; then
  $TF_PYTHON src/download_data.py --quickdraw --tuberlin --imagenetsketch
fi

$TF_PYTHON src/preprocess.py
