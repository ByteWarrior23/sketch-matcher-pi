#!/bin/bash
#PBS -N sketch_train_student
#PBS -q workq
#PBS -l select=1:ncpus=8:ngpus=1:mem=32gb
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o /Data4/ee_24126016/sketch_matcher/train_student.log

# GPU job: STUDENT phase only (MobileNetV3Large, 3 stages) with distillation.
# Requires teacher_model.keras + cached teacher embeddings from
#   qsub hpc/job_train_teacher.pbs
#
# MAX-ACCURACY MODE: waits for a FREE FULL H100 (not a MIG slice). Polls every
# 10 min; after H100_WAIT_MIN (default 1440 min = 24h) falls back to a free
# MIG slice. Set H100_WAIT_MIN=0 to skip the wait.

cd /Data4/ee_24126016/sketch_matcher

# --- Conda env ---
source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate sketch_matcher
export PYTHONNOUSERSITE=1
# Cap TF/numpy/cv2 threads WELL below the allocated ncpus. The node watchdog
# SIGKILLs jobs whose cpupercent exceeds the granted ncpus (observed kills at
# cpupercent 235-494% with 8 ncpus): TF's intraop pool AND cv2's internal
# thread pool each scale to all 128 physical cores otherwise. cv2 threads are
# additionally capped to 1 in data_loader.py.
export OMP_NUM_THREADS=4
export TF_NUM_INTRAOP_THREADS=4
export TF_NUM_INTEROP_THREADS=1
export OPENBLAS_NUM_THREADS=4
export MKL_NUM_THREADS=4
# Use the CUDA 13.0 ptxas (supports CC 9.0 / H100) instead of the default
# CUDA 11.8 one -- XLA's subprocess kernel compilation needs a ptxas that
# understands sm_90a, otherwise depthwise convs crash with "ptxas too old".
export PATH="/usr/local/cuda-13.0/bin:$PATH"
# Workaround for "Autotuner could not compile any configs for HLO": XLA's
# fusion autotuner needs a ptxas for CC 9.0 (H100), but the system toolkit is
# CUDA 11.8. Disable the Triton GEMM fusion path and the config autotuner so
# XLA uses driver-JIT kernels instead of ptxas-compiled ones.
export XLA_FLAGS="--xla_gpu_enable_triton_gemm=false --xla_gpu_autotune_level=0"
TF_PYTHON="$CONDA_PREFIX/bin/python"
echo "Using python: $TF_PYTHON"

# --- GPU selection: prefer a FREE FULL H100, wait for it, else MIG fallback ---
# Only MIG-Disabled (true full) H100s qualify -- MIG-sliced GPUs 0-4 look
# "free" via compute-apps when their slices are idle, but they are NOT whole
# GPUs. Returns the GPU UUID (GPU-xxxx) of the first free full H100:
# CUDA_VISIBLE_DEVICES accepts GPU UUIDs (CUDA >= 11.2); numeric device
# indices are unsafe here because MIG renumbers CUDA devices.
pick_full() {
  while IFS= read -r line; do
    local IDX UUID USED_MEM
    IDX=$(printf '%s\n' "$line" | cut -d',' -f1 | tr -d ' ')
    UUID=$(nvidia-smi --query-gpu=uuid --format=csv,noheader -i "$IDX" 2>/dev/null | tr -d '\r' | head -1)
    USED_MEM=$(nvidia-smi --query-compute-apps=gpu_index,used_gpu_memory --format=csv,noheader 2>/dev/null \
      | awk -v i="$IDX" -F', ' '$1==i {gsub(/MiB/,"",$2); s+=$2} END {print s+0}')
    if [ -z "$USED_MEM" ] || [ "$USED_MEM" -lt 4096 ]; then echo "$UUID"; return; fi
  done < <(nvidia-smi --query-gpu=index,mig.mode.current --format=csv,noheader 2>/dev/null | grep -i disabled)
}
pick_mig() {
  local USED=$(nvidia-smi --query-compute-apps=gpu_uuid --format=csv,noheader 2>/dev/null | sort -u)
  for u in $(nvidia-smi -L 2>/dev/null | grep "MIG" | sed 's/.*(UUID: //; s/)//'); do
    if ! printf '%s\n' "$USED" | grep -q "$u"; then echo "$u"; return; fi
  done
}
if [ -z "$CUDA_VISIBLE_DEVICES" ]; then
  export H100_WAIT_MIN="${H100_WAIT_MIN:-1440}"
  echo "$(date) Waiting up to ${H100_WAIT_MIN} min for a FREE FULL H100..."
  WAITED=0
  while [ $WAITED -lt $H100_WAIT_MIN ]; do
    U=$(pick_full)
    if [ -n "$U" ]; then break; fi
    sleep 600
    WAITED=$((WAITED + 10))
    if [ $((WAITED % 60)) -eq 0 ]; then echo "$(date) Still waiting for full H100 (${WAITED} min elapsed)..."; fi
  done
  if [ -z "$U" ]; then
    U=$(pick_mig)
    if [ -z "$U" ]; then
      echo "$(date) ERROR: no free full H100 after ${H100_WAIT_MIN} min and no free MIG. Requeue manually."
      exit 1
    fi
    echo "$(date) WARNING: full H100 wait expired; falling back to MIG slice $U"
  else
    echo "$(date) Got FULL H100: $U"
  fi
  export CUDA_VISIBLE_DEVICES="$U"
fi
echo "CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES"
nvidia-smi -L

$TF_PYTHON src/train.py --phase student
