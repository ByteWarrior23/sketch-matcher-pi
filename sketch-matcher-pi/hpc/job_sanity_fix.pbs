#!/bin/bash
#PBS -N sketch_sanity_fix
#PBS -q cpuq
#PBS -l select=1:ncpus=16
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /Data4/ee_24126016/sketch_matcher/sanity_fix.log

# CPU-ONLY sanity check of the ROOT-CAUSE fixes (input range + contrastive
# loss, ArcFace off) BEFORE launching the expensive GPU retrain.
#   cd /Data4/ee_24126016/sketch_matcher && qsub hpc/job_sanity_fix.pbs

cd /Data4/ee_24126016/sketch_matcher

source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate sketch_matcher
export PYTHONNOUSERSITE=1
export CUDA_VISIBLE_DEVICES=""
export XLA_FLAGS="--xla_gpu_autotune_level=0"
export TF_CPP_MIN_LOG_LEVEL=1
export OMP_NUM_THREADS=4
export OMP_INTEROP=1
export MKL_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
TF_PYTHON="$CONDA_PREFIX/bin/python"
echo "Using python: $TF_PYTHON"

$TF_PYTHON hpc/sanity_fix.py
