#!/bin/bash
#PBS -N sketch_collapse
#PBS -q cpuq
#PBS -l select=1:ncpus=8
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /Data4/ee_24126016/sketch_matcher/collapse.log

cd /Data4/ee_24126016/sketch_matcher

source /apps/compilers/anaconda3/etc/profile.d/conda.sh
conda activate sketch_matcher
export PYTHONNOUSERSITE=1
export CUDA_VISIBLE_DEVICES=""
export XLA_FLAGS="--xla_gpu_autotune_level=0"
export TF_CPP_MIN_LOG_LEVEL=1
export OMP_NUM_THREADS=4
export OMP_INTEROP=1
export MKL_NUM_THREADS=4
export OPENBLAS_NUM_THREADS=4
TF_PYTHON="$CONDA_PREFIX/bin/python"

$TF_PYTHON src/check_teacher.py
