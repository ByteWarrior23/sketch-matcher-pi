#!/bin/bash
#PBS -N rps_export
#PBS -q cpuq
#PBS -l select=1:ncpus=8
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /Data4/ee_24126016/sketch_matcher/rps_export.log

# TFLite int8 export + int8 accuracy check. Runs AFTER the train job (afterok).
cd /Data4/ee_24126016/sketch_matcher/camera_pi_projects/rps

export TF_PYTHON=/Data4/ee_24126016/.conda/envs/sketch_matcher/bin/python
if [ ! -x "$TF_PYTHON" ]; then
  source /apps/compilers/anaconda3/etc/profile.d/conda.sh
  conda activate sketch_matcher
  export TF_PYTHON="$CONDA_PREFIX/bin/python"
fi
if [ ! -x "$TF_PYTHON" ]; then
  echo "FATAL: no working env python ($TF_PYTHON)"
  exit 2
fi
export PYTHONNOUSERSITE=1
export OMP_NUM_THREADS=8
export TF_NUM_INTRAOP_THREADS=8
export TF_NUM_INTEROP_THREADS=1
export OPENBLAS_NUM_THREADS=8
export MKL_NUM_THREADS=8
echo "Using python: $TF_PYTHON"

$TF_PYTHON hpc/rps_export.py
if [ $? -ne 0 ]; then echo "EXPORT FAILED"; exit 5; fi
echo "$(date) RPS_EXPORT_DONE"
